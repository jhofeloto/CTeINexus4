{
  "tech_stack": [
    "TypeScript",
    "Next.js",
    "React",
    "PostgreSQL",
    "Prisma",
    "NextAuth.js",
    "Cloudinary",
    "Tailwind CSS",
    "Zod"
  ],
  "features": [
    {
      "name": "Projects API",
      "description": "API para gestión completa de proyectos CTeI (Ciencia, Tecnología e Innovación). Permite crear, leer, actualizar y eliminar proyectos de investigación con validación de datos y autenticación.",
      "files": [
        "app/api/projects/route.ts",
        "app/api/projects/[id]/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Projects API",
          "version": "1.0.0",
          "description": "API para gestión de proyectos CTeI"
        },
        "paths": {
          "/api/projects": {
            "get": {
              "summary": "Obtener proyectos del usuario",
              "responses": {
                "200": {
                  "description": "Lista de proyectos del usuario autenticado",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Project"
                        }
                      }
                    }
                  }
                },
                "401": {
                  "description": "No autorizado"
                }
              }
            },
            "post": {
              "summary": "Crear nuevo proyecto",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CreateProject"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Proyecto creado exitosamente"
                },
                "400": {
                  "description": "Datos inválidos"
                },
                "401": {
                  "description": "No autorizado"
                }
              }
            }
          },
          "/api/projects/{id}": {
            "get": {
              "summary": "Obtener proyecto específico",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Detalles del proyecto"
                },
                "404": {
                  "description": "Proyecto no encontrado"
                }
              }
            },
            "put": {
              "summary": "Actualizar proyecto",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/UpdateProject"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Proyecto actualizado exitosamente"
                },
                "404": {
                  "description": "Proyecto no encontrado"
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Project": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proponentEntity": {
                  "type": "string"
                },
                "startDate": {
                  "type": "string",
                  "format": "date"
                },
                "endDate": {
                  "type": "string",
                  "format": "date"
                },
                "budget": {
                  "type": "number"
                },
                "isPublic": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string",
                  "enum": ["PROPOSED", "IN_PROGRESS", "COMPLETED", "CANCELLED"]
                }
              }
            },
            "CreateProject": {
              "type": "object",
              "required": ["title", "summary", "keywords", "proponentEntity"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "proponentEntity": {
                  "type": "string",
                  "minLength": 1
                },
                "startDate": {
                  "type": "string",
                  "format": "date"
                },
                "endDate": {
                  "type": "string",
                  "format": "date"
                },
                "budget": {
                  "type": "number"
                },
                "isPublic": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "UpdateProject": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "status": {
                  "type": "string",
                  "enum": ["PROPOSED", "IN_PROGRESS", "COMPLETED", "CANCELLED"]
                },
                "proponentEntity": {
                  "type": "string",
                  "minLength": 1
                },
                "startDate": {
                  "type": "string",
                  "format": "date"
                },
                "endDate": {
                  "type": "string",
                  "format": "date"
                },
                "budget": {
                  "type": "number"
                },
                "isPublic": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Products API",
      "description": "API para gestión de productos CTeI asociados a proyectos. Permite crear, leer, actualizar y eliminar productos con diferentes tipos y categorías.",
      "files": [
        "app/api/products/route.ts",
        "app/api/products/[id]/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Products API",
          "version": "1.0.0",
          "description": "API para gestión de productos CTeI"
        },
        "paths": {
          "/api/products": {
            "get": {
              "summary": "Obtener productos del usuario",
              "parameters": [
                {
                  "name": "projectId",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  },
                  "description": "Filtrar por proyecto específico"
                }
              ],
              "responses": {
                "200": {
                  "description": "Lista de productos del usuario"
                },
                "401": {
                  "description": "No autorizado"
                }
              }
            },
            "post": {
              "summary": "Crear nuevo producto",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CreateProduct"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Producto creado exitosamente"
                },
                "400": {
                  "description": "Datos inválidos"
                },
                "404": {
                  "description": "Proyecto o tipo de producto no encontrado"
                }
              }
            }
          },
          "/api/products/{id}": {
            "get": {
              "summary": "Obtener producto específico",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Detalles del producto"
                },
                "404": {
                  "description": "Producto no encontrado"
                }
              }
            },
            "put": {
              "summary": "Actualizar producto",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/UpdateProduct"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Producto actualizado exitosamente"
                },
                "404": {
                  "description": "Producto no encontrado"
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Product": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "productUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "isPublic": {
                  "type": "boolean"
                },
                "projectId": {
                  "type": "string"
                },
                "productTypeId": {
                  "type": "string"
                }
              }
            },
            "CreateProduct": {
              "type": "object",
              "required": ["title", "summary", "productTypeId", "projectId"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "productUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "productTypeId": {
                  "type": "string",
                  "minLength": 1
                },
                "projectId": {
                  "type": "string",
                  "minLength": 1
                },
                "isPublic": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "UpdateProduct": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "productUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "isPublic": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Product Types API",
      "description": "API para obtener los tipos de productos CTeI disponibles. Proporciona una lista de 20 categorías diferentes de productos de investigación.",
      "files": [
        "app/api/product-types/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Product Types API",
          "version": "1.0.0",
          "description": "API para obtener tipos de productos CTeI"
        },
        "paths": {
          "/api/product-types": {
            "get": {
              "summary": "Obtener tipos de productos disponibles",
              "responses": {
                "200": {
                  "description": "Lista de tipos de productos CTeI",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/ProductType"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "ProductType": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Public Projects API",
      "description": "API pública para buscar y explorar proyectos CTeI públicos. Permite búsqueda por texto, paginación y acceso sin autenticación.",
      "files": [
        "app/api/public/projects/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Public Projects API",
          "version": "1.0.0",
          "description": "API pública para explorar proyectos CTeI"
        },
        "paths": {
          "/api/public/projects": {
            "get": {
              "summary": "Buscar proyectos públicos",
              "parameters": [
                {
                  "name": "search",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  },
                  "description": "Término de búsqueda en título, resumen o palabras clave"
                },
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "default": 10,
                    "maximum": 50
                  },
                  "description": "Número de resultados por página"
                },
                {
                  "name": "offset",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "default": 0
                  },
                  "description": "Número de resultados a omitir"
                }
              ],
              "responses": {
                "200": {
                  "description": "Lista de proyectos públicos con paginación",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "projects": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/PublicProject"
                            }
                          },
                          "pagination": {
                            "$ref": "#/components/schemas/Pagination"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "PublicProject": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proponentEntity": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "products": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicProduct"
                  }
                }
              }
            },
            "PublicProduct": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "productType": {
                  "$ref": "#/components/schemas/ProductType"
                }
              }
            },
            "Pagination": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer"
                },
                "limit": {
                  "type": "integer"
                },
                "offset": {
                  "type": "integer"
                },
                "hasMore": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "File Upload API",
      "description": "API para subir y gestionar archivos asociados a proyectos y productos. Integra con Cloudinary para almacenamiento y proporciona validación de permisos.",
      "files": [
        "app/api/upload/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "File Upload API",
          "version": "1.0.0",
          "description": "API para gestión de archivos"
        },
        "paths": {
          "/api/upload": {
            "post": {
              "summary": "Subir archivo",
              "requestBody": {
                "required": true,
                "content": {
                  "multipart/form-data": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "format": "binary"
                        },
                        "entityType": {
                          "type": "string",
                          "enum": ["project", "product"]
                        },
                        "entityId": {
                          "type": "string"
                        },
                        "fileName": {
                          "type": "string"
                        }
                      },
                      "required": ["file", "entityType", "entityId"]
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Archivo subido exitosamente",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "attachment": {
                            "$ref": "#/components/schemas/Attachment"
                          }
                        }
                      }
                    }
                  }
                },
                "400": {
                  "description": "Datos inválidos o archivo requerido"
                },
                "401": {
                  "description": "No autorizado"
                },
                "404": {
                  "description": "Entidad no encontrada o sin permisos"
                }
              }
            },
            "delete": {
              "summary": "Eliminar archivo",
              "parameters": [
                {
                  "name": "id",
                  "in": "query",
                  "required": true,
                  "schema": {
                    "type": "string"
                  },
                  "description": "ID del archivo a eliminar"
                }
              ],
              "responses": {
                "200": {
                  "description": "Archivo eliminado exitosamente"
                },
                "400": {
                  "description": "ID de archivo requerido"
                },
                "401": {
                  "description": "No autorizado"
                },
                "404": {
                  "description": "Archivo no encontrado o sin permisos"
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Attachment": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "fileName": {
                  "type": "string"
                },
                "fileSize": {
                  "type": "integer"
                },
                "mimeType": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Authentication API",
      "description": "API de autenticación basada en NextAuth.js con soporte para Google OAuth. Proporciona login, logout y gestión de sesiones.",
      "files": [
        "app/api/auth/[...nextauth]/route.ts",
        "lib/auth.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Authentication API",
          "version": "1.0.0",
          "description": "API de autenticación con NextAuth.js"
        },
        "paths": {
          "/api/auth/signin": {
            "get": {
              "summary": "Página de inicio de sesión",
              "responses": {
                "200": {
                  "description": "Página de login"
                }
              }
            }
          },
          "/api/auth/signout": {
            "post": {
              "summary": "Cerrar sesión",
              "responses": {
                "200": {
                  "description": "Sesión cerrada exitosamente"
                }
              }
            }
          },
          "/api/auth/session": {
            "get": {
              "summary": "Obtener sesión actual",
              "responses": {
                "200": {
                  "description": "Información de la sesión actual",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/Session"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Session": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "image": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                },
                "expires": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  ]
}
